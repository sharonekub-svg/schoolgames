{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node setup.mjs && node make-thumbs.mjs && node build.mjs",
  "installCommand": "echo \"no dependencies\"",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
